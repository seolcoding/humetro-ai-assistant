        "provider": "ollama",
        "model": "ollama/exaone3.5:7.8b",
        "config": {
          "api_base": "http://100.95.220.92:11434",
          "temperature": 0.7,
          "max_tokens": 8192
        }
      }
    ]
  },
  "retrieval": {
    "k": 2,
    "naive_vector_store": null,
    "kg_config": {
      "mode": "cypher_generation",
