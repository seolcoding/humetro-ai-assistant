  <data key="d1">data</data>
  <data key="d2">혈중알코올농도 measures the concentration of alcohol in the bloodstream, which is critical in determining the legal implications of drunk driving incidents.</data>
  <data key="d3">chunk-2a1032532e7f073f4ff38fb2c5ad38f3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
