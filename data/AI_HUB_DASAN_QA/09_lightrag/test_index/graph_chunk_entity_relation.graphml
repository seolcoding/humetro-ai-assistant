  <data key="d0">1인 가구</data>
  <data key="d1">concept</data>
  <data key="d2">1인 가구 refers to single-person households which have specific eligibility criteria for receiving living support funds.&lt;SEP&gt;A one-person household is a category for determining financial assistance amounts.</data>
  <data key="d3">chunk-8d5b3f2a0e7e199b157e1ecf282f2f45&lt;SEP&gt;chunk-7409884c6a7155d8a0daaf1585f5e8fd</data>
