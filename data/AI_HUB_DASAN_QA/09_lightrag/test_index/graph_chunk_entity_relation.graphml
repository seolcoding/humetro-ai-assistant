</node>
<node id="Ulsan">
  <data key="d0">Ulsan</data>
  <data key="d1">location</data>
  <data key="d2">Ulsan is a city in South Korea, mentioned as the starting point for train travel to Jeonju Hanok Village.</data>
  <data key="d3">chunk-e8c7676651f1e741dad39444bd4225de</data>
  <data key="d4">unknown_source</data>
