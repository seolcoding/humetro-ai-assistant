  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="Tax Assessment Date">
  <data key="d0">Tax Assessment Date</data>
  <data key="d1">concept</data>
  <data key="d2">The Tax Assessment Date is June 1, on which property taxes are imposed based on ownership at that time.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="Late Payment Penalty">
  <data key="d0">Late Payment Penalty</data>
  <data key="d1">concept</data>
  <data key="d2">The Late Payment Penalty incurs a 3% fine for late tax payments, with additional monthly penalties for unpaid amounts over a certain threshold.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="Public Holiday Payment Deadline">
  <data key="d0">Public Holiday Payment Deadline</data>
  <data key="d1">concept</data>
  <data key="d2">The Public Holiday Payment Deadline states that if the payment deadline falls on a Saturday or public holiday, it extends to the next business day.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="District Office Taxation Department">
  <data key="d0">District Office Taxation Department</data>
  <data key="d1">organization</data>
  <data key="d2">The District Office Taxation Department is the authoritative body providing accurate guidance on property tax matters.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="Childcare Center">
  <data key="d0">Childcare Center</data>
  <data key="d1">organization</data>
  <data key="d2">A Childcare Center is a facility where the child care staff must adhere to health and safety guidelines, including mask mandates during the pandemic.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="Mask Compliance Reporting">
  <data key="d0">Mask Compliance Reporting</data>
  <data key="d1">concept</data>
  <data key="d2">Mask Compliance Reporting involves notifying authorities when childcare staff do not wear masks as required.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="Childcare Staff">
  <data key="d0">Childcare Staff</data>
  <data key="d1">person</data>
  <data key="d2">Childcare Staff are individuals responsible for the care of children at the childcare center and must follow health safety regulations.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847786</data>
  <data key="d6"></data>
</node>
<node id="Childcare Evaluation Certification">
  <data key="d0">Childcare Evaluation Certification</data>
  <data key="d1">concept</data>
  <data key="d2">Childcare Evaluation Certification is a system that assesses and certifies the quality of childcare services in facilities.</data>
  <data key="d3">chunk-b8a521e72858f13aa5823dd1ff96861c</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
  <data key="d6"></data>
</node>
<node id="Mask">
  <data key="d0">Mask</data>
  <data key="d1">artifact</data>
  <data key="d2">A Mask is an essential piece of personal protective equipment that should be worn correctly to prevent the spread of infectious diseases, particularly during the COVID-19 pandemic.</data>
  <data key="d3">chunk-4fd50c360c8172eddb13644a1ff21589</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
  <data key="d6"></data>
</node>
<node id="Cosmetics">
  <data key="d0">Cosmetics</data>
  <data key="d1">artifact</data>
  <data key="d2">Cosmetics refer to makeup products that, when worn under a mask, can contaminate the inside of the mask and reduce its effectiveness in preventing infection.</data>
  <data key="d3">chunk-4fd50c360c8172eddb13644a1ff21589</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
  <data key="d6"></data>
</node>
<node id="Tissue">
  <data key="d0">Tissue</data>
  <data key="d1">artifact</data>
  <data key="d2">Tissue is a paper product mentioned as a possible but not recommended addition inside a mask to prevent contamination.</data>
  <data key="d3">chunk-4fd50c360c8172eddb13644a1ff21589</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
  <data key="d6"></data>
</node>
<node id="Cotton Mask">
  <data key="d0">Cotton Mask</data>
  <data key="d1">artifact</data>
  <data key="d2">Cotton Mask is proposed as an alternative to health masks, which can be used while ensuring proper fit and adherence to guidelines.</data>
  <data key="d3">chunk-4fd50c360c8172eddb13644a1ff21589</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
  <data key="d6"></data>
</node>
<node id="Personal Protective Equipment">
  <data key="d0">Personal Protective Equipment</data>
  <data key="d1">concept</data>
  <data key="d2">Personal Protective Equipment refers to gear, like masks, designed to protect the wearer from hazards, including infectious diseases such as COVID-19.</data>
  <data key="d3">chunk-4fd50c360c8172eddb13644a1ff21589</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
  <data key="d6"></data>
</node>
<node id="운전면허">
  <data key="d0">운전면허</data>
  <data key="d1">concept</data>
  <data key="d2">운전면허 refers to the legal authorization to operate a motor vehicle, which can be canceled due to infractions such as drunk driving.</data>
  <data key="d3">chunk-2a1032532e7f073f4ff38fb2c5ad38f3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
