<node id="이사정산">
  <data key="d0">이사정산</data>
  <data key="d1">concept</data>
  <data key="d2">Moving settlement for water charges refers to the process of calculating and settling water fees when changing residences.&lt;SEP&gt;이사정산 is the process of settling the water bill when moving to a new residence.</data>
  <data key="d3">chunk-2c7b31a8bce1c77f19769ebb31f5750a&lt;SEP&gt;chunk-b5fd5f90104cdd435a3370d45417fc97</data>
  <data key="d4">unknown_source</data>
