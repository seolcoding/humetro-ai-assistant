  <data key="d0">열람실</data>
  <data key="d1">artifact</data>
  <data key="d2">열람실 is a reading room within the 정독도서관 where patrons can study or use computers.</data>
  <data key="d3">chunk-2c7b31a8bce1c77f19769ebb31f5750a</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847845</data>
