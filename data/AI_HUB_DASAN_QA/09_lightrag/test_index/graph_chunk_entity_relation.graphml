</node>
<node id="Receipt">
  <data key="d0">Receipt</data>
  <data key="d1">data</data>
  <data key="d2">A Receipt is required for expenditure verification, especially when purchases are made online and the details need to be confirmed.</data>
  <data key="d3">chunk-e8c7676651f1e741dad39444bd4225de</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847846</data>
