</node>
<node id="광진구">
  <data key="d0">광진구</data>
  <data key="d1">location</data>
  <data key="d2">광진구 is a district in Seoul, South Korea, which is the administrative area for the 지원금 program.</data>
  <data key="d3">chunk-317799b4564220b78af1c973d13748bd</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847488</data>
  <data key="d6"></data>
</node>
<node id="서울특별시">
  <data key="d0">서울특별시</data>
  <data key="d1">location</data>
  <data key="d2">서울특별시 is the capital city of South Korea, where 광진구 is located.&lt;SEP&gt;서울특별시는 서울시청이 소속된 지역으로, 고용유지지원금의 지원 대상 지역이다.</data>
  <data key="d3">chunk-317799b4564220b78af1c973d13748bd&lt;SEP&gt;chunk-a906344898db2026c83c60f663348594</data>
  <data key="d4">unknown_source</data>
