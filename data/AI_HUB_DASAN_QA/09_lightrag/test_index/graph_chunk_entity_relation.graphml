  <data key="d1">organization</data>
  <data key="d2">국민행정심판 is an organization that provides resources for individuals seeking to challenge administrative decisions, including consulting and case reviews.</data>
  <data key="d3">chunk-2a1032532e7f073f4ff38fb2c5ad38f3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
