<node id="Social Distancing Level 2">
  <data key="d0">Social Distancing Level 2</data>
  <data key="d1">concept</data>
  <data key="d2">Social Distancing Level 2 refers to the public health measures implemented in Seoul to mitigate COVID-19 spread, effective from August 19, 2020.&lt;SEP&gt;Social Distancing Level 2 refers to a public health measure implemented in response to the COVID-19 pandemic to limit social activities and gatherings.</data>
  <data key="d3">chunk-dd3d9738621636ff604645c3110d93d8&lt;SEP&gt;chunk-6417f794db060808b5c639a8f93ec8ad</data>
