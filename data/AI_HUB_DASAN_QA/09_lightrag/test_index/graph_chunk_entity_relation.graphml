  <data key="d0">음주운전</data>
  <data key="d1">concept</data>
  <data key="d2">음주운전 refers to the act of driving a vehicle while under the influence of alcohol, leading to potential legal consequences including license cancellation.</data>
  <data key="d3">chunk-2a1032532e7f073f4ff38fb2c5ad38f3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847787</data>
