<node id="Dream Account Check Card">
  <data key="d0">Dream Account Check Card</data>
  <data key="d1">artifact</data>
  <data key="d2">The Dream Account Check Card is the only accepted payment method for expenses paid with the Seoul Youth Allowance.</data>
  <data key="d3">chunk-e8c7676651f1e741dad39444bd4225de</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847845</data>
  <data key="d6"></data>
</node>
<node id="Employment Center">
  <data key="d0">Employment Center</data>
  <data key="d1">organization</data>
  <data key="d2">The Employment Center is the authority where young individuals must submit receipts for purchases made with the Seoul Youth Allowance if required.</data>
  <data key="d3">chunk-e8c7676651f1e741dad39444bd4225de</data>
  <data key="d4">unknown_source</data>
