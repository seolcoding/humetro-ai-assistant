  <data key="d0">5인 미만 소상공인 사업주</data>
  <data key="d1">person</data>
  <data key="d2">5인 미만 소상공인 사업주 refers to small business owners in 광진구 with less than five employees who are eligible for the financial assistance.</data>
  <data key="d3">chunk-317799b4564220b78af1c973d13748bd</data>
  <data key="d4">unknown_source</data>
