  <data key="d0">지침</data>
  <data key="d1">data</data>
  <data key="d2">Final reading refers to the last recorded measurement from the water meter before moving.&lt;SEP&gt;지침 refers to the final reading of the water meter, which is needed for billing.</data>
  <data key="d3">chunk-2c7b31a8bce1c77f19769ebb31f5750a&lt;SEP&gt;chunk-b5fd5f90104cdd435a3370d45417fc97</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847845</data>
  <data key="d6"></data>
</node>
<node id="이메일 청구서">
  <data key="d0">이메일 청구서</data>
  <data key="d1">concept</data>
  <data key="d2">Email billing is a digital method of receiving utility charge statements via email.&lt;SEP&gt;이메일 청구서 is the electronic version of the water bill sent to customers instead of a paper version.</data>
  <data key="d3">chunk-2c7b31a8bce1c77f19769ebb31f5750a&lt;SEP&gt;chunk-b5fd5f90104cdd435a3370d45417fc97</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1762847845</data>
