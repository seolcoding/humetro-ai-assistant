        {
          "speaker": "상담사",
          "turn_number": "10",
          "qa_type": "A",
          "content": "네, 많이 불편하셨겠어요,"
        },
        {
          "speaker": "고객",
          "turn_number": "11",
          "qa_type": "Q",
          "content": "600번 버스 배차 간격이 어떻게 되죠?",
