  "dialogues": [
    {
      "dialogue_id": "B22388",
      "category": "대중교통 안내",
      "turns": 20,
      "conversation": [
        {
          "speaker": "고객",
          "turn_number": "1",
          "qa_type": "Q",
          "content": "홍수때문에 현재 지하철 운행이 가능한지 문의하고 싶어요.",
          "intent": "지하철운행",
          "terms": "지하철/교통수단",
          "knowledge_base": "지하철,교통수단"
        },
        {
          "speaker": "상담사",
          "turn_number": "2",
          "qa_type": "Q",
          "content": "어느 지하철을 이용하실 예정이십니까?",
          "intent": "지하철운행",
          "terms": "지하철/교통수단",
          "knowledge_base": "지하철,교통수단"
        },
        {
          "speaker": "고객",
          "turn_number": "3",
          "qa_type": "A",
          "content": "2호선이요.",
          "terms": "2호선/노선",
          "knowledge_base": "2호선,노선"
        },
        {
          "speaker": "상담사",
          "turn_number": "4",
          "qa_type": "Q",
          "content": "혹시 가시고자 하는 구간이 어디인가요?",
          "intent": "지하철운행",
          "knowledge_base": "구간"
        },
        {
          "speaker": "고객",
          "turn_number": "5",
          "qa_type": "A",
          "content": "신도림역에서 강남역까지 가려고 합니다.",
          "terms": "지역,역/역사",
          "knowledge_base": "강남,역사"
        },
        {
          "speaker": "상담사",
          "turn_number": "6",
          "qa_type": "A",
          "content": "잠시만요. 조회해보겠습니다. 고객님 현재 강남역 인근 도로가 일부 침수되었으나 지하철은 정상운행되고 있습니다.",
          "terms": "역/역사,지하철/교통수단",
          "knowledge_base": "역,교통수단"
        },
        {
          "speaker": "고객",
          "turn_number": "7",
          "qa_type": "Q",
          "content": "네. 그렇군요. 그럼 출구로 나갈 수는 있나요?",
          "intent": "지하철운행",
          "knowledge_base": "출구"
        },
        {
          "speaker": "상담사",
          "turn_number": "8",
          "qa_type": "A",
          "content": "네. 현재 출구로 나가는 것은 가능하나 도로가 일부 침수되어 통행이 불편하실 수 있다는 점 참고하시기 바랍니다.",
          "knowledge_base": "침수"
        },
        {
          "speaker": "고객",
          "turn_number": "9",
          "qa_type": "Q",
          "content": "그러면 제가 교보문고에 가려고 하는데 강남역 말고 다른 역으로 가는 방법이 있을까요?",
          "intent": "지하철 노선",
          "terms": "교보문고/서점,강남/지역,역/역사",
          "knowledge_base": "강남,역사"
        },
        {
          "speaker": "상담사",
          "turn_number": "10",
          "qa_type": "Q",
          "content": "가시는 목적지가 교보문고 강남점이신가요?",
          "intent": "지하철 노선",
          "terms": "교보문고/서점,강남/지역",
          "knowledge_base": "교보문고,지역"
        },
        {
          "speaker": "고객",
          "turn_number": "11",
          "qa_type": "A",
          "content": "네. 그렇습니다."
        },
        {
          "speaker": "상담사",
          "turn_number": "12",
          "qa_type": "A",
          "content": "다시 조회해 보도록 하겠습니다. 교보문고 강남점에서 가장 가까운 역은 9호선 신논현역으로 검색됩니다.",
          "terms": "교보문고/서점,강남/지역,신논연/지역,9호선/노선",
          "knowledge_base": "강남,노선"
        },
        {
          "speaker": "고객",
          "turn_number": "13",
          "qa_type": "Q",
          "content": "어디에서 9호선으로 환승해야 하나요?",
          "intent": "지하철 노선",
          "terms": "9호선/노선,환승/길안내",
          "knowledge_base": "환승,길안내"
        },
        {
          "speaker": "상담사",
          "turn_number": "14",
          "qa_type": "A",
          "content": "가장 빠른 방법으로 안내해 드리도록 하겠습니다. 신도림역에서 1호선을 타시고, 노량진역에서 9호선으로 환승하시면 됩니다.",
          "terms": "지역,역사,노선",
          "knowledge_base": "노량진,노선"
        },
        {
          "speaker": "고객",
          "turn_number": "15",
          "qa_type": "Q",
          "content": "2호선으로 한번에 가는 방법과 요금이 같나요?",
          "intent": "지하철 요금",
          "terms": "2호선/노선,요금/돈",
          "knowledge_base": "요금,돈"
        },
        {
          "speaker": "상담사",
          "turn_number": "16",
          "qa_type": "A",
          "content": "네. 1,350원으로 동일합니다.",
          "terms": "1,350원/돈",
          "knowledge_base": "350원,돈"
        },
        {
          "speaker": "고객",
          "turn_number": "17",
          "qa_type": "A",
          "content": "그렇군요. 감사합니다."
        },
        {
          "speaker": "고객",
          "turn_number": "18",
          "qa_type": "Q",
          "content": "신논현역에서 교보문고는 얼마나 걸리나요?",
          "intent": "길안내",
          "terms": "지역,역사,서점",
          "knowledge_base": "역,서점"
        },
        {
          "speaker": "상담사",
          "turn_number": "19",
          "qa_type": "A",
          "content": "7번 출구에서 지하로 바로 연결되어 있습니다.",
          "knowledge_base": "출구"
        },
        {
          "speaker": "고객",
          "turn_number": "20",
          "qa_type": "A",
          "content": "비가 많이 오니 환승하더라도 실내로만 다닐 수 있어서 이 방법이 훨씬 좋겠네요. 알려주셔서 감사합니다."
        }
      ]
    },
    {
      "dialogue_id": "B22389",
      "category": "대중교통 안내",
      "turns": 20,
      "conversation": [
        {
          "speaker": "고객",
          "turn_number": "1",
          "qa_type": "Q",
          "content": "안녕하세요. 지금 인천공항인데 차가 없어서 대중교통을 타야하는데 잘모르겠어서요",
          "intent": "교통문의",
          "terms": "공항/대중교통",
          "knowledge_base": "대중교통"
        },
        {
          "speaker": "상담사",
          "turn_number": "2",
          "qa_type": "Q",
          "content": "인천공항 1터미널이신가요? 2터미널이신가요?",
          "intent": "",
          "knowledge_base": "2터미털"
        },
        {
          "speaker": "고객",
          "turn_number": "3",
          "qa_type": "A",
          "content": "1터미널입니다."
        },
        {
          "speaker": "상담사",
          "turn_number": "4",
          "qa_type": "A",
          "content": "네고객님 안내드리겠습니다.",
          "knowledge_base": "안내"
        },
        {
          "speaker": "상담사",
          "turn_number": "5",
          "qa_type": "Q",
          "content": "혹시 가시려고 하시는 지역이 어디신지요?",
          "intent": "교통문의",
          "knowledge_base": "지역"
        },
        {
          "speaker": "고객",
          "turn_number": "6",
          "qa_type": "A",
          "content": "네 구리까지 가야하는데요",
          "knowledge_base": "구리"
        },
        {
          "speaker": "상담사",
          "turn_number": "7",
          "qa_type": "A",
          "content": "일단 인천공항에서 이용하실수있는 대중교통이 버스, 지하철, 공항순환버스, 택시가 있습니다.",
          "terms": "공항/대중교통/교통수단/공항순환버스,택시,지하철",
          "knowledge_base": "대중교통,지하철"
        },
        {
          "speaker": "고객",
          "turn_number": "8",
          "qa_type": "A",
          "content": "네~ 교통편이 많이 있네요."
        },
        {
          "speaker": "상담사",
          "turn_number": "9",
          "qa_type": "Q",
          "content": "네 어떤 걸로 안내드릴까요?",
          "intent": "교통문의"
        },
        {
          "speaker": "고객",
          "turn_number": "10",
          "qa_type": "A",
          "content": "네 가장 빠른 걸로 안내부탁드리겠습니다."
        },
        {
          "speaker": "상담사",
          "turn_number": "11",
          "qa_type": "A",
          "content": "가장 빠른걸 원하시면 택시를 타시는게 맞으신데 구리까지면 요금이 많이 나요실수도 있습니다. 공항순환버스 안내드릴까요?",
          "terms": "요금/택시/공항/승차장/순환버스",
          "knowledge_base": "구리,순환버스"
        },
        {
          "speaker": "고객",
          "turn_number": "12",
          "qa_type": "Q",
          "content": "버스도 금방 갈까요?",
          "intent": "교통문의"
        },
        {
          "speaker": "상담사",
          "turn_number": "13",
          "qa_type": "A",
          "content": "네 고객님 공항에서 탑승하시면 구리시외버스터미널에서 바로 하차 가능하십니다.",
          "terms": "버스터미널/공항/탑승",
          "knowledge_base": "탑승"
        },
        {
          "speaker": "고객",
          "turn_number": "14",
          "qa_type": "Q",
          "content": "네~ 어디서 타면 되나요?",
          "intent": "교통문의"
        },
        {
          "speaker": "상담사",
          "turn_number": "15",
          "qa_type": "A",
          "content": "인천공항 1층 입국장(T1)에서 8843번을 탑승하시면 되는데요.  승차홈 확인하시고 타시면 됩니다.",
          "knowledge_base": "1층"
        },
        {
          "speaker": "고객",
          "turn_number": "16",
          "qa_type": "Q",
          "content": "얼마나걸려요?",
          "intent": "교통문의"
        },
        {
          "speaker": "상담사",
          "turn_number": "17",
          "qa_type": "A",
          "content": "소요시간은 1시간 30분 정도입니다.",
          "terms": "소요시간/시간",
          "knowledge_base": "1시간30분,시간"
        },
        {
          "speaker": "고객",
          "turn_number": "18",
          "qa_type": "Q",
          "content": "요금은 얼마인가요?",
          "intent": "교통문의",
          "terms": "요금/돈",
          "knowledge_base": "요금,돈"
        },
        {
          "speaker": "상담사",
          "turn_number": "19",
          "qa_type": "A",
          "content": "13,500원입니다.",
          "knowledge_base": "500원"
        },
        {
          "speaker": "고객",
          "turn_number": "20",
          "qa_type": "A",
          "content": "네. 알겠습니다."
        }
      ]
    },
