{
  "experiment_name": "Dasan Naive RAG Pilot - GPT-4o-mini vs EXAONE",
  "description": "AI_HUB_DASAN_QA 데이터셋 기반 Naive RAG 성능 평가 (2 models, 25 questions)",
  "version": "v4",
  "dataset": {
    "name": "AI_HUB_DASAN_QA",
    "source": "data/AI_HUB_DASAN_QA/03_markdown_full",
    "vector_store": "data/AI_HUB_DASAN_QA/07_vector_stores/full",
    "total_documents": 9624,
    "total_chunks": 23631
  },
  "question_generation": {
    "num_questions": 25,
    "num_documents": 100,
    "generation_model": "gpt-4o-mini",
    "force_regenerate": true,
    "random_sampling": true
  },
  "models_to_evaluate": [
    {
      "id": "gpt-4o-mini",
      "name": "GPT-4o-mini",
      "provider": "openai",
      "description": "OpenAI의 경량 모델"
    },
    {
      "id": "ollama/exaone3.5:7.8b",
      "name": "EXAONE-3.5-7.8B",
      "provider": "ollama",
      "description": "LG AI Research의 한국어 특화 모델"
    }
  ],
  "rag_configuration": {
    "type": "naive_rag",
    "retrieval_enabled": true,
    "k_documents": 4,
    "search_type": "similarity",
    "embedding_model": "text-embedding-3-large"
  },
  "evaluation": {
    "judge_model": "vertex_ai/gemini-1.5-pro-002",
    "judge_model_notes": "Gemini 2.5 Pro는 vertex_ai/gemini-2.5-pro (2025년 출시 예정)",
    "metrics": [
      "faithfulness",
      "answer_relevancy",
      "answer_correctness"
    ],
    "parallel_evaluation": true,
    "max_concurrent": 2
  },
  "output": {
    "output_dir": "data/evaluation/dasan_naive_rag_pilot",
    "save_checkpoints": true,
    "verbose": true
  },
  "execution_command": "uv run python src/rag_pipeline/unified_benchmark_v4_dasan.py --questions 25 --models gpt-4o-mini ollama/exaone3.5:7.8b --judge-model vertex_ai/gemini-1.5-pro-002 --k-documents 4 --max-concurrent 2 --output-dir data/evaluation/dasan_naive_rag_pilot --verbose",
  "notes": [
    "첫 번째 AI_HUB_DASAN_QA 데이터셋 기반 실험",
    "Naive RAG 성능 베이스라인 확립",
    "향후 KG RAG와 비교를 위한 기준선",
    "Vertex AI Gemini 1.5 Pro를 judge로 사용 (환경변수 VERTEXAI_PROJECT 필요)"
  ],
  "environment_requirements": {
    "VERTEXAI_PROJECT": "astute-coda-477522-r1",
    "VERTEXAI_PROJECT_SERVICE_ACCOUNT": "service_account.json",
    "VERTEX_LOCATION": "asia-northeast3 (auto-configured)"
  }
}
