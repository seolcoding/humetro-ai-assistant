{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RAG Benchmark Configuration Schema",
  "description": "Complete configuration for RAG benchmark experiments",
  "type": "object",
  "required": ["experiment", "questions", "models", "evaluation"],
  "properties": {
    "experiment": {
      "type": "object",
      "description": "Experiment metadata and control",
      "required": ["name"],
      "properties": {
        "id": {
          "type": ["integer", "null"],
          "description": "Resume existing experiment ID, null for new experiment"
        },
        "name": {
          "type": "string",
          "description": "Experiment name (used in output files)"
        },
        "description": {
          "type": "string",
          "description": "Human-readable experiment description"
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Tags for categorization and filtering"
        },
        "output_dir": {
          "type": "string",
          "default": "data/evaluation/experiments",
          "description": "Output directory for results"
        }
      }
    },
    "questions": {
      "type": "object",
      "description": "Question source configuration",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["cached", "generate"],
          "description": "Use cached questions or generate new ones"
        },
        "cache_key": {
          "type": "string",
          "description": "Cache key for source=cached (required if cached)"
        },
        "generation": {
          "type": "object",
          "description": "Configuration for source=generate",
          "properties": {
            "model": {
              "type": "string",
              "default": "gpt-4o-mini",
              "description": "LLM model for question generation"
            },
            "temperature": {
              "type": "number",
              "default": 0.3,
              "minimum": 0.0,
              "maximum": 1.0
            },
            "num_documents": {
              "type": "integer",
              "default": 50,
              "description": "Number of source documents to use"
            },
            "num_questions": {
              "type": "integer",
              "default": 50,
              "description": "Number of questions to generate"
            },
            "document_source": {
              "type": "string",
              "default": "data/crawled/seoul_traffic/markdown_filtered"
            },
            "embedding_model": {
              "type": "string",
              "default": "text-embedding-3-small"
            },
            "use_korean_personas": {
              "type": "boolean",
              "default": true
            },
            "force_regenerate": {
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Models to evaluate",
      "required": ["evaluation_targets"],
      "properties": {
        "evaluation_targets": {
          "oneOf": [
            {"type": "string", "enum": ["all", "thesis", "openai", "ollama", "korean", "fast"]},
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "provider"],
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"},
                  "provider": {"type": "string", "enum": ["openai", "ollama", "anthropic"]},
                  "model": {"type": "string"},
                  "config": {
                    "type": "object",
                    "properties": {
                      "api_base": {"type": ["string", "null"]},
                      "temperature": {"type": "number"},
                      "max_tokens": {"type": "integer"}
                    }
                  }
                }
              }
            }
          ],
          "description": "Preset name or custom model list"
        }
      }
    },
    "retrieval": {
      "type": "object",
      "description": "Retrieval configuration",
      "required": ["method"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["none", "naive", "kg", "hybrid"],
          "description": "Retrieval method: none=LLM only, naive=FAISS, kg=Neo4j KG"
        },
        "k": {
          "type": "integer",
          "default": 4,
          "description": "Number of documents to retrieve"
        },
        "vector_store_path": {
          "type": "string",
          "description": "Path to FAISS vector store (for method=naive)"
        },
        "kg_config": {
          "type": "object",
          "description": "Neo4j KG configuration (for method=kg)",
          "properties": {
            "neo4j_uri": {"type": "string"},
            "neo4j_user": {"type": "string"},
            "neo4j_password": {"type": "string"},
            "index_name": {"type": "string", "default": "vector"},
            "retrieval_query": {"type": ["string", "null"]}
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "description": "Evaluation and judging configuration",
      "required": ["judge_model"],
      "properties": {
        "judge_model": {
          "type": "string",
          "default": "gpt-5",
          "description": "LLM model for evaluation judging"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "faithfulness",
              "answer_relevancy",
              "answer_correctness",
              "context_precision",
              "context_recall"
            ]
          },
          "default": ["faithfulness", "answer_relevancy", "answer_correctness"]
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Execution control settings",
      "properties": {
        "checkpoint_interval": {
          "type": "integer",
          "default": 5,
          "description": "Save checkpoint every N questions"
        },
        "verbose": {
          "type": "boolean",
          "default": false
        },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "description": "Print plan without execution"
        }
      }
    }
  }
}
