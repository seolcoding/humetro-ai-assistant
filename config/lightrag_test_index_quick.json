{
  "experiment": {
    "name": "lightrag_test_index_quick",
    "description": "Quick LightRAG test with test index (100 docs)",
    "version": "1.0",
    "tags": ["lightrag", "test-index", "quick-test", "validation"]
  },
  "data": {
    "source": "golden_testset",
    "golden_testset_path": "data/evaluation/testsets/golden_testset_50.csv",
    "num_questions": 10,
    "sampling": {
      "strategy": "random",
      "seed": 42
    },
    "note": "Using first 10 questions from golden testset"
  },
  "lightrag": {
    "working_dir": "data/AI_HUB_DASAN_QA/09_lightrag/test_index",
    "query_mode": "hybrid",
    "k_documents": 4,
    "embedding_model": "text-embedding-3-large",
    "llm_model": "gpt-4o-mini",
    "note": "Test index with only 100 documents for pipeline validation"
  },
  "models": {
    "evaluation_targets": [
      "gpt-4o-mini",
      "ollama/exaone3.5:7.8b"
    ],
    "note": "Quick test with 2 models: 1 OpenAI + 1 Ollama"
  },
  "evaluation": {
    "judge_model": "vertex_ai/gemini-2.5-pro",
    "metrics": [
      "faithfulness",
      "answer_relevancy",
      "answer_correctness"
    ],
    "execution": {
      "mode": "sequential",
      "max_concurrent": 1,
      "note": "Sequential mode for API stability"
    }
  },
  "output": {
    "dir": "data/evaluation/lightrag_test_index_quick",
    "save_intermediate": true,
    "checkpoint_interval": 5
  },
  "notes": {
    "purpose": "Pipeline validation with test index before full index build",
    "expected_runtime": "20-30 minutes (10 questions × 2 models × 3 metrics)",
    "limitations": "Only 100 documents indexed - limited retrieval quality"
  }
}
