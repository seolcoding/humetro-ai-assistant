{
  "experiment": {
    "id": null,
    "name": "kg_rag_50q",
    "description": "Knowledge Graph RAG evaluation with Neo4j (50 questions)",
    "tags": ["comparison", "kg-rag", "50q"],
    "output_dir": "data/evaluation/rag_comparison"
  },
  "questions": {
    "source": "cached",
    "cache_key": "359312cb043d5a69",
    "comment": "SAME questions as naive_rag for fair comparison"
  },
  "models": {
    "evaluation_targets": [
      {
        "id": "gpt-4o-mini",
        "name": "GPT-4o-mini",
        "provider": "openai",
        "model": "gpt-4o-mini",
        "config": {
          "temperature": 0.7,
          "max_tokens": 1024
        }
      },
      {
        "id": "exaone",
        "name": "EXAONE-3.5-7.8B",
        "provider": "ollama",
        "model": "ollama/exaone3.5:7.8b",
        "config": {
          "api_base": "http://100.95.220.92:11434",
          "temperature": 0.7
        }
      }
    ]
  },
  "retrieval": {
    "method": "kg",
    "k": 4,
    "kg_config": {
      "neo4j_uri": "env:NEO4J_URI",
      "neo4j_user": "env:NEO4J_USER",
      "neo4j_password": "env:NEO4J_PASSWORD",
      "index_name": "vector",
      "embedding_model": "text-embedding-3-large",
      "retrieval_query": null
    },
    "comment": "Neo4j Knowledge Graph with vector + graph traversal"
  },
  "evaluation": {
    "judge_model": "gpt-5",
    "metrics": ["faithfulness", "answer_relevancy", "answer_correctness", "context_recall"],
    "comment": "SAME judge and metrics as naive_rag for fair comparison"
  },
  "execution": {
    "checkpoint_interval": 5,
    "verbose": true,
    "dry_run": false
  }
}
